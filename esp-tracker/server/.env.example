DB_PATH=./tracker.db

# SMS provider: "semaphore" (PH-local, cheap for PH numbers), "twilio", or
# "console" for development (prints instead of sending).
SMS_PROVIDER=console
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Must match SMS_CMD_SECRET in tracker/include/config.h. Without it the device's
# number is a remote-control interface for anyone who learns it.
SMS_CMD_SECRET=change-me

# Geolocation provider for Wi-Fi BSSID resolution. The key lives HERE, never on
# the device and never in the frontend.
GEOLOCATION_PROVIDER=unwiredlabs
GEOLOCATION_API_KEY=

SESSION_TTL_HOURS=12

# Session cookies are Secure by default and so are refused over plain HTTP.
# Set to 0 for local development ONLY. Never on anything internet-reachable.
COOKIE_SECURE=1
